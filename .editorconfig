root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,md}]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2

[*.cs]
# --- usings -----------------------------------------------------------------
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# --- language style ---------------------------------------------------------
csharp_style_namespace_declarations = file_scoped:error
csharp_prefer_braces = when_multiline:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error

# --- naming -----------------------------------------------------------------
dotnet_naming_rule.private_fields_underscore.severity = error
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# --- rules deliberately relaxed for a faithful port -------------------------
# The TypeScript source is the specification (AGENTS.md). These analysers push
# toward .NET idiom in ways that would force the port away from it. Each is
# relaxed on purpose; do not silence others without recording why here.
dotnet_diagnostic.CA1002.severity = none   # expose List<T> - upstream shapes use arrays/lists directly
dotnet_diagnostic.CA1051.severity = none   # visible instance fields - editor base classes mirror TS
dotnet_diagnostic.CA1707.severity = none   # underscores in names - test method names mirror upstream
dotnet_diagnostic.CA1716.severity = none   # reserved-word identifiers - upstream names win
dotnet_diagnostic.CA2007.severity = none   # ConfigureAwait - not a library-in-someone-else's-SynchronizationContext
dotnet_diagnostic.CA1062.severity = none   # null checks on public args - nullable reference types cover this

[tests/**/*.cs]
dotnet_diagnostic.CA1515.severity = none   # types can be internal - test classes are public by convention

[reference/**]
generated_code = true
